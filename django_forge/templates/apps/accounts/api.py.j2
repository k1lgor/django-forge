"""API views for the accounts application.

Conditional on whether DRF or Ninja is selected.
"""
{% if use_drf %}
from django.contrib.auth import get_user_model
from django.urls import include
from rest_framework import serializers, viewsets
from rest_framework.routers import DefaultRouter


class UserSerializer(serializers.ModelSerializer):
    """Serializer for the User model."""

    class Meta:
        model = get_user_model()
        fields = ("id", "email", "is_active", "date_joined")
        read_only_fields = ("id", "date_joined")


class UserViewSet(viewsets.ReadOnlyModelViewSet):
    """API endpoint for viewing users."""

    queryset = get_user_model().objects.all()
    serializer_class = UserSerializer


router = DefaultRouter()
router.register(r"users", UserViewSet)

api_urls = include(router.urls)
{% elif use_ninja %}
from django.urls import include
from ninja import ModelSchema, NinjaAPI, Router

from apps.accounts.models import User


class UserSchema(ModelSchema):
    """Schema for the User model."""

    class Meta:
        model = User
        fields = ("id", "email", "is_active", "date_joined")


router = Router()


@router.get("/users", response=list[UserSchema])
def list_users(request):  # noqa: ARG001 — ninja injects the request positionally
    """List all users."""
    return User.objects.all()


api = NinjaAPI()
api.add_router("", router)

# ninja's .urls is a (patterns, app_name, namespace) 3-tuple — Django 6's
# include() rejects 3-tuples, so split it here; the namespace is required
# because ninja reverses its own `api-<version>` namespace at request time.
api_urls = include(api.urls[:2], namespace=api.urls[2])
{% else %}
# No API framework selected — config/urls.py mounts neither api_urls nor
# accounts/api. If you add DRF or Ninja later, enable the dependency in
# pyproject.toml and update this file plus config/urls.py.
{% endif %}