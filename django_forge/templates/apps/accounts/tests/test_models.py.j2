"""Tests for the custom User model."""

import pytest
from django.contrib.auth import get_user_model

User = get_user_model()


@pytest.mark.django_db
def test_create_user_with_email() -> None:
    """A user can be created with email and password."""
    user = User.objects.create_user(
        email="user@example.com", password="testpass123"
    )
    assert user.email == "user@example.com"
    assert user.check_password("testpass123")
    assert user.is_active is True
    assert user.is_staff is False
    assert user.is_superuser is False


@pytest.mark.django_db
def test_create_superuser() -> None:
    """A superuser can be created with email and password."""
    admin = User.objects.create_superuser(
        email="admin@example.com", password="adminpass123"
    )
    assert admin.email == "admin@example.com"
    assert admin.is_staff is True
    assert admin.is_superuser is True


@pytest.mark.django_db
def test_user_str_is_email() -> None:
    """The string representation of a user is their email."""
    user = User.objects.create_user(
        email="display@example.com", password="testpass123"
    )
    assert str(user) == "display@example.com"


@pytest.mark.django_db
def test_create_user_without_email_raises_error() -> None:
    """Creating a user without email raises ValueError."""
    with pytest.raises(ValueError, match="email address must be set"):
        User.objects.create_user(email="", password="testpass123")
