{% if has_preflight %}"""Pre-deploy safety checks — run before pushing."""

from django.core.management import call_command
from django.core.management.base import BaseCommand


class Command(BaseCommand):
    """Run the deploy check, pending-migrations check, and migrate check."""

    help = "Preflight: check --deploy, pending migrations, migrate --check."

    def handle(self, *args, **options) -> None:
        self.stdout.write("1/3 Deploy check (check --deploy)")
        call_command("check", deploy=True)

        self.stdout.write("2/3 Pending migrations check")
        call_command("makemigrations", check=True, dry_run=True)

        self.stdout.write("3/3 Migration state check (migrate --check)")
        call_command("migrate", check=True)

        self.stdout.write(self.style.SUCCESS("Preflight passed — safe to deploy"))
{% endif %}
