.PHONY: lint typecheck test check run migrate makemigrations seed preflight backup restore

lint:
	uv run ruff check .
	uv run ruff format --check .

typecheck:
	uv run ty check

test:
	uv run pytest

check: lint typecheck test

run:
	uv run manage.py runserver

migrate:
	uv run manage.py migrate

makemigrations:
	uv run manage.py makemigrations
{% if has_seed %}
seed:
	uv run manage.py seed
{% endif %}
{% if has_preflight %}
preflight:
	uv run manage.py preflight
{% endif %}
{% if has_backup %}
backup:
	uv run manage.py dbbackup

restore:
	uv run manage.py dbrestore
{% endif %}
