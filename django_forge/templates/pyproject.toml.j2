[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }} — scaffolded by django-forge"
requires-python = ">=3.12,<3.15"
dependencies = [
    "django~=6.1.0",
    "dj-database-url~=3.1.0",
{%- if db == "postgres" %}
    "psycopg[binary]~=3.2",
{%- endif %}
{%- if use_drf %}
    "djangorestframework~=3.18.0",
    "djangorestframework-simplejwt~=5.5.0",
{%- endif %}
{%- if use_ninja %}
    "django-ninja~=1.7.0",
    "django-ninja-jwt>=5.1,<6",
{%- endif %}
    "uvicorn[standard]~=0.54.0",
    "whitenoise~=6.12.0",
    "django-cors-headers~=4.9.0",
    "pydantic-settings~=2.16.0",
    "django-allauth~=65.21.0",
{%- if has_docker %}
    "gunicorn>=23,<27",
{%- endif %}
{%- if has_audit %}
    "django-simple-history>=3.7,<4.0",
{%- endif %}
{%- if has_healthcheck %}
    "django-health-check>=4.6,<5",
{%- endif %}
{%- if has_backup %}
    "django-dbbackup>=4.2,<6",
{%- endif %}
{%- if has_celery %}
    "celery~=5.6.0",
    "redis>=5.0,<9.0",
{%- endif %}
{%- if has_cache and not has_celery %}
    "redis>=5.0,<9.0",
{%- endif %}
{%- if has_storage %}
    "django-storages[s3]>=1.14,<2.0",
{%- endif %}
]

[dependency-groups]
dev = [
    "ruff>=0.8,<1.0",
    "ty>=0.0.35,<1.0",
    "pytest>=8.0,<9.0",
    "pytest-django>=4.9,<5.0",
    "factory-boy>=3.3,<4.0",
    "coverage>=7.6,<8.0",
    "django-debug-toolbar>=4.4,<9.0",
]

[build-system]
requires = ["setuptools"]
build-backend = "setuptools.build_meta"

[tool.ruff]
line-length = 100
target-version = "py312"
# Generated migrations are machine-written: lint never reformats them.
# extend-exclude ADDS to ruff's defaults (.venv, .git, ...); a bare
# exclude would REPLACE them and lint the whole virtualenv.
extend-exclude = ["**/migrations/*"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "N", "UP", "B", "SIM", "ARG", "RUF"]

[tool.ruff.format]
quote-style = "double"
indent-style = "space"

[tool.ty]
[tool.ty.environment]
python-version = "3.12"

[tool.setuptools.packages.find]
include = ["apps*", "config*", "tests*"]

[tool.pytest.ini_options]
minversion = "8.0"
testpaths = ["tests"]
DJANGO_SETTINGS_MODULE = "config.settings.base"
# pytest-django forces DEBUG=False unless enabled; the shipped test asserts True.
django_debug_mode = true
