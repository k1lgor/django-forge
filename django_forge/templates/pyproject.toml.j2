[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }} — scaffolded by django-forge"
requires-python = ">=3.12"
dependencies = [
    "django~=5.1.0",
{%- if use_drf %}
    "djangorestframework~=3.15.0",
    "djangorestframework-simplejwt~=5.5.0",
{%- endif %}
{%- if use_ninja %}
    "django-ninja~=1.4.0",
    "django-ninja-jwt~=5.0.0",
{%- endif %}
    "uvicorn[standard]~=0.34.0",
    "whitenoise~=6.9.0",
    "django-cors-headers~=4.7.0",
    "pydantic-settings~=2.8.0",
    "django-allauth~=65.6.0",
{%- if has_docker %}
    "gunicorn~=23.0",
{%- endif %}
{%- if has_celery %}
    "celery~=5.4.0",
    "redis>=5.0,<6.0",
{%- endif %}
{%- if has_cache and not has_celery %}
    "redis>=5.0,<6.0",
{%- endif %}
{%- if has_storage %}
    "django-storages[s3]>=1.14,<2.0",
{%- endif %}
]

[project.optional-dependencies]
dev = [
    "ruff>=0.8,<1.0",
    "ty>=0.0.35,<1.0",
    "pytest>=8.0,<9.0",
    "pytest-django>=4.9,<5.0",
    "factory-boy>=3.3,<4.0",
    "coverage>=7.6,<8.0",
    "django-debug-toolbar>=4.4,<5.0",
]

[build-system]
requires = ["setuptools"]
build-backend = "setuptools.build_meta"

[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "N", "UP", "B", "SIM", "ARG", "RUF"]

[tool.ruff.format]
quote-style = "double"
indent-style = "space"

[tool.ty]
[tool.ty.environment]
python-version = "3.12"

[tool.setuptools.packages.find]
include = ["apps*", "config*", "tests*"]

[tool.pytest.ini_options]
minversion = "8.0"
testpaths = ["tests"]
env = [
    "DJANGO_SETTINGS_MODULE=config.settings.base",
]
