"""Django settings for {{ project_name }}."""

from pathlib import Path

from pydantic_settings import BaseSettings


class Settings(BaseSettings):
    """Application settings loaded from environment variables."""

    # Django
    django_secret_key: str = "{{ secret_key }}"
    django_debug: bool = True
    allowed_hosts: list[str] = ["localhost", "127.0.0.1", "0.0.0.0"]

    # Database
{% if db == "postgres" %}
    database_url: str = "sqlite:///local.sqlite3"
{% else %}
    database_url: str = "sqlite:///local.sqlite3"
{% endif %}

{% if has_celery %}    # Celery
    celery_broker_url: str = "redis://localhost:6379/0"
    celery_result_backend: str = "redis://localhost:6379/0"

{% endif %}{% if has_cache %}    # Cache
    cache_redis_url: str = "redis://localhost:6379/1"

{% endif %}{% if has_email %}    # Email
    email_backend: str = "django.core.mail.backends.smtp.EmailBackend"
    email_host: str = "localhost"
    email_port: int = 587
    email_host_user: str = ""
    email_host_password: str = ""
    email_use_tls: bool = True

{% endif %}{% if has_storage %}    # S3 / MinIO
    aws_access_key_id: str = ""
    aws_secret_access_key: str = ""
    aws_storage_bucket_name: str = ""
    aws_s3_endpoint_url: str = ""
    aws_s3_region_name: str = "us-east-1"

{% endif %}    # Security
    cors_allowed_origins: list[str] = ["http://localhost:8000"]


