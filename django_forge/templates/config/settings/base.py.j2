# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
{% if db == "postgres" %}
import re

_db_match = re.match(
    r"(?P<engine>\w+)://(?P<user>[^:]+):(?P<password>[^@]+)@(?P<host>[^:]+):(?P<port>\d+)/(?P<name>.+)",
    settings.database_url,
)
if _db_match and _db_match.group("engine") == "postgresql":
    DATABASES = {
        "default": {
            "ENGINE": "django.db.backends.postgresql",
            "NAME": _db_match.group("name"),
            "USER": _db_match.group("user"),
            "PASSWORD": _db_match.group("password"),
            "HOST": _db_match.group("host"),
            "PORT": int(_db_match.group("port")),
        }
    }
else:
    DATABASES = {
        "default": {
            "ENGINE": "django.db.backends.sqlite3",
            "NAME": BASE_DIR / "local.sqlite3",
        }
    }
{% else %}
DATABASES = {
    "default": {
        "ENGINE": "django.db.backends.sqlite3",
        "NAME": BASE_DIR / "local.sqlite3",
    }
}
{% endif %}

