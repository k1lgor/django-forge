# Django
DJANGO_SECRET_KEY={{ secret_key }}
DJANGO_SETTINGS_MODULE=config.settings.base
DJANGO_DEBUG=true

# Database
{% if db == "postgres" %}DATABASE_URL=postgres://user:password@localhost:5432/{{ project_slug }}{% endif -%}

# Security
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Docker (set to true when running in Docker)
{%- if has_docker %}DOCKER=true{% endif %}

{% if has_email %}# Email (Mailpit in development, SMTP in production)
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
{% endif -%}

# Sentry (optional — set DSN to enable)
SENTRY_DSN=
{% if has_social %}
# Social Auth (Google + GitHub OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
{% endif -%}
{% if has_storage %}
# S3 / MinIO Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
{% endif -%}
