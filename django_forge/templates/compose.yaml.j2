{% if has_docker %}services:
  app:
    build: .
    ports:
      - "8000:8000"
    env_file:
      - .env
    environment:
      - DJANGO_SETTINGS_MODULE=config.settings.base
    volumes:
      - static_volume:/app/staticfiles
      - media_volume:/app/media
{%- if db == "postgres" or has_celery or has_cache %}
    depends_on:
{%- endif %}
{%- if db == "postgres" %}
      db:
        condition: service_healthy
{%- endif %}
{%- if has_celery or has_cache %}
      redis:
        condition: service_started
{%- endif %}

{%- if db == "postgres" %}
  db:
    image: postgres:17-alpine
    restart: unless-stopped
    volumes:
      - postgres_data:/var/lib/postgresql/data
    environment:
      POSTGRES_DB: {{ project_slug }}
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
    ports:
      - "5432:5432"
{%- endif %}

{%- if has_celery or has_cache %}
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5
    volumes:
      - redis_data:/data
{%- endif %}

{%- if has_email %}
  mailpit:
    image: axllent/mailpit:v1
    restart: unless-stopped
    ports:
      - "1025:1025"
      - "8025:8025"
    environment:
      MP_SMTP_AUTH: "false"
      MP_SMTP_TLS: "false"
{%- endif %}

volumes:
  static_volume:
  media_volume:
{%- if db == "postgres" %}
  postgres_data:
{%- endif %}
{%- if has_celery or has_cache %}
  redis_data:
{%- endif %}
{% endif %}
